  "location_note": {
    "text": "S-06、S-10与L-10是古代宫殿房间和壁板的对应记录，不是今天的博物馆展厅号。纳尔逊的L-10据馆方所引Meuszyński研究，未独立核读原书；梵蒂冈的I-04重建线索据已读2019年图录，保留与现场展签的差异。",
    "sources": [
      "cdli-s06",
      "nelson",
      "sama-label",
      "basello-2019"
    ]
  },
  "collection_note": "本辑按六组亲见记录整理：金贝尔的一组含两件残片，克利夫兰的拼合壁板仍计作一件馆藏作品。",
  "comparison_intro": "金贝尔两件残片各高约91—92厘米；休斯顿那件高约1.07米，克利夫兰与纳尔逊两件高约2.3米，圣安东尼奥所见头像高约67厘米。照片按各自比例展示，彼此并非实物等比例。",
  "rooms": [
    {
      "title": "S室：从全身到头像",
      "text": "克利夫兰S-06与在圣安东尼奥借展的S-10头像，连接同一房间的两处壁板。一个保留动作，一个留下面容。",
      "works": [
        "cleveland-1943-246",
        "sama-head"
      ],
      "sources": [
        "cleveland",
        "cdli-s06",
        "sama-label"
      ]
    },
    {
      "title": "L室：完整壁板与两块残片",
      "text": "纳尔逊对应L-10；金贝尔的一对也记为L室，但现有资料未给出具体壁板号。这让它们有了原建筑上的联系，尚不能将两块残片直接安放到L-10旁。",
      "works": [
        "nelson-40-17",
        "kimbell-pair"
      ],
      "sources": [
        "nelson",
        "kimbell"
      ]
    },
    {
      "title": "梵蒂冈：两种原位记录",
      "text": "Inv.14990的展签记L室，研究重建则提出I室I-04。房间与上下层的归属在此并列保留；休斯顿80.53的原房间仍未查明。",
      "works": [
        "vatican-14990",
        "mfah-80-53"
      ],
      "sources": [
        "vatican-label",
        "basello-2019"
      ]
    }
  ]
