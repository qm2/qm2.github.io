  "groups": [
    {
      "id": "letters",
      "title": "五个房间，一封看不见的信",
      "text": "先看独自读信与写信的两个人，再看2025年弗里克专题中的三件双人场景。同是书信，有人在阅读，有人在递交，也有人只是在等待。",
      "works": [
        "blue-letter",
        "lady-writing",
        "mistress-maid",
        "love-letter",
        "letter-maid"
      ]
    },
    {
      "id": "faces",
      "title": "三张脸，三种回望",
      "text": "海牙、纽约、华盛顿的三件作品放在一起：人物都朝我们转来，头巾、披巾、红帽与背景，却让每次对视各不相同。",
      "works": [
        "girl-pearl",
        "young-woman",
        "red-hat"
      ]
    },
    {
      "id": "delft",
      "title": "远处的城，门前的小街",
      "text": "一幅隔着水看城市，一幅站在街边看住家。比较人在画里的大小，再看建筑怎样被亮处与暗处重新组织。",
      "works": [
        "view-delft",
        "little-street"
      ]
    },
    {
      "id": "hands",
      "title": "注意力停在手上",
      "text": "倒奶、编花边、拿水壶、触碰天球仪。题材各异，手与物之间很小的动作，却都能让整幅画安静下来。",
      "works": [
        "milkmaid",
        "lacemaker",
        "water-pitcher",
        "astronomer"
      ]
    },
    {
      "id": "company",
      "title": "房间里多了另一个人",
      "text": "从等待合奏的琴手，到交谈的两个人，再到被打断的音乐。看椅子、桌子和窗户怎样安排人物之间的距离。",
      "works": [
        "lute",
        "officer-laughing-girl",
        "music-interrupted"
      ]
    },
    {
      "id": "interpretation",
      "title": "不急着替画面下结论",
      "text": "天平、宗教象征、打盹的女仆，都曾引出道德与信仰的解读。把它们并排看，也留意每幅画究竟交代了什么、又省去了什么。",
      "works": [
        "balance",
        "faith",
        "maid-asleep"
      ]
    }
