  "periods": [
    {
      "id": "early",
      "title": "早年罗马",
      "range": "1590年代",
      "intro": "牌桌、果篮、音乐与神话。人离画面很近，颜色也还明亮。"
    },
    {
      "id": "rome",
      "title": "罗马时期的宗教画",
      "range": "1599—1606",
      "intro": "从私人画室走进礼拜堂。圣经故事里的手、脚和目光，都有了具体的重量。"
    },
    {
      "id": "late",
      "title": "转折与最后几年",
      "range": "1606—1610",
      "intro": "从1606年前后的沉思，到生命末年的几件画。动作渐少，情绪更难一眼读尽。"
    },
    {
      "id": "question",
      "title": "留下一个问号",
      "range": "归属讨论",
      "intro": "也把尚无定论的作品留下来，保留展签上的问号。"
    }
  ],
  "groups": [
    {
      "id": "deception",
      "title": "牌桌与手相",
      "text": "目光吸引注意，手在另一处完成骗局。两幅《占卜者》与《纸牌作弊者》连着看。",
      "works": [
        "cardsharps",
        "fortune-capitoline",
        "fortune-louvre"
      ]
    },
    {
      "id": "john",
      "title": "四次画约翰",
      "text": "从抱公羊的笑容，到荒野里的沉思，再到晚年的疲惫。同一位圣人，没有固定的面孔。",
      "works": [
        "john-capitoline",
        "john-corsini",
        "john-nelson",
        "john-borghese"
      ]
    },
    {
      "id": "matthew",
      "title": "一座礼拜堂的三面墙",
      "text": "左壁蒙召，中央书写，右壁殉道。一起看，也回到它们原来的空间。",
      "works": [
        "calling-matthew",
        "inspiration-matthew",
        "martyrdom-matthew"
      ]
    },
    {
      "id": "heads",
      "title": "同样是被斩下的头",
      "text": "《美杜莎》的惊惧、《朱迪思》的动作，以及《大卫》停下来的目光。",
      "works": [
        "medusa",
        "judith",
        "david"
      ]
    },
    {
      "id": "quiet",
      "title": "把动作收起来",
      "text": "书写、凝视头骨、否认自己的身份。几只手就足以撑起整个画面。",
      "works": [
        "saint-jerome",
        "francis",
        "denial-peter"
      ]
    },
    {
      "id": "young",
      "title": "早年的年轻面孔",
      "text": "果篮、酒杯和乐器都被放到身前。身体与静物一起占据画面。",
      "works": [
        "boy-fruit",
        "sick-bacchus",
        "bacchus",
        "musicians"
      ]
    },
    {
      "id": "altars",
      "title": "祭坛画的不同去向",
      "text": "有的还在原处，有的被撤下，有的被运到巴黎又归还。收藏史从委托时就已经开始。",
      "works": [
        "madonna-pilgrims",
        "madonna-palafrenieri",
        "death-virgin",
        "entombment"
      ]
    }
  ],
