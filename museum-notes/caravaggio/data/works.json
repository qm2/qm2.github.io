  "works": [
    {
      "id": "sick-bacchus",
      "photo": "caravaggio-490.jpg",
      "source_number": 490,
      "title": "病中的酒神",
      "original_title": "Self-portrait as Bacchus / Bacchino malato",
      "date": "1593—1595年",
      "year": 1594,
      "period": "early",
      "museum": "borghese",
      "accession": "534",
      "tags": [
        "myth",
        "early"
      ],
      "observation": "脸色发白，嘴唇也没有多少血色，手里的葡萄却还饱满。和乌菲兹的《酒神》并排看，这个年轻人显得更局促。",
      "story": "博尔盖塞将它题作“扮作酒神的自画像”。“病中”的叫法来自对人物气色的解释，不能据此替画家诊断某种疾病。这幅画原在阿尔皮诺骑士的收藏中；1607年，其藏画被没收，随后由教皇保罗五世赠给侄子希皮奥内·博尔盖塞。",
      "source_url": "https://www.collezionegalleriaborghese.it/en/opere/self-portrait-as-bacchus-known-as-sick-bacchus",
      "source_note": "",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "label_number": 491
    },
    {
      "id": "boy-fruit",
      "photo": "caravaggio-512.jpg",
      "source_number": 512,
      "title": "捧果篮的男孩",
      "original_title": "Boy with a Basket of Fruit",
      "date": "约1595年",
      "year": 1595,
      "period": "early",
      "museum": "borghese",
      "accession": "136",
      "tags": [
        "early"
      ],
      "observation": "露出的肩膀、张开的嘴和拥到胸前的果篮挤在一处。果实有光泽，叶子却卷曲、破损；这篮水果并没有被画得样样完美。",
      "story": "这幅画与《病中的酒神》有同一段收藏经历：1607年从阿尔皮诺骑士被没收的藏画中，转入博尔盖塞家族。它属于画家早年在罗马的作品，花果也让人看见他观察自然的本领。",
      "source_url": "https://www.collezionegalleriaborghese.it/en/opere/boy-with-basket-of-fruit",
      "source_note": "照片中的法文展签标为约1596年；博尔盖塞线上目录标为约1595年。所属收藏与拍摄地点分开记录。",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "visit": "雅克马尔—安德烈美术馆 · 巴黎（据展签标识）",
      "extra_source": [
        "雅克马尔—安德烈：博尔盖塞收藏展",
        "https://www.musee-jacquemart-andre.com/en/masterpieces-borghese-gallery"
      ],
      "label_number": 513
    },
    {
      "id": "cardsharps",
      "photo": "caravaggio-470.jpg",
      "source_number": 470,
      "title": "纸牌作弊者",
      "original_title": "The Cardsharps",
      "date": "约1596—1597年",
      "year": 1596,
      "period": "early",
      "museum": "kimbell",
      "accession": "AP 1987.06",
      "tags": [
        "deception",
        "early"
      ],
      "observation": "先看三个人的手：一个专心看牌，一个在背后打手势，另一个伸向腰后的暗牌。骗局已经摆在观众面前，桌边的年轻人还不知道。",
      "story": "德尔·蒙特枢机买下这幅画，还给卡拉瓦乔提供住处，让他进入罗马重要的赞助人圈子。画作后来有近九十年下落不明，1987年在欧洲私人收藏中重新被认出；画背发现的德尔·蒙特印记，也帮助确认了这段早期来源。",
      "source_url": "https://kimbellart.org/collection/ap-198706",
      "source_note": "",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "label_number": 471
    },
    {
      "id": "fortune-capitoline",
      "photo": "caravaggio-480.jpg",
      "source_number": 480,
      "title": "占卜者 · 罗马本",
      "original_title": "The Fortune Teller / La buona ventura",
      "date": "1596—1597年",
      "year": 1597,
      "period": "early",
      "museum": "capitoline",
      "accession": "PC 131",
      "tags": [
        "deception",
        "early"
      ],
      "observation": "两个人似乎只是交换目光。真正的事情发生在画面下方：看手相的接触，给了女子悄悄取下戒指的机会。",
      "story": "这是卡比托利欧收藏的一本，与卢浮宫本是两件不同的作品。青年衣服的条纹、头上的羽饰和女子的动作，可以逐项对照。馆方目录记录它来自皮奥收藏；作品也与德尔·蒙特早年的收藏活动有关。",
      "source_url": "https://www.museicapitolini.org/it/opera/la-buona-ventura",
      "source_note": "现场展签标1597年；馆方线上记录采用1596—1597年。",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "extra_source": [
        "金贝尔：《纸牌作弊者》及德尔·蒙特收藏印记",
        "https://kimbellart.org/collection/ap-198706"
      ],
      "label_number": 481
    },
    {
      "id": "fortune-louvre",
      "photo": "caravaggio-508.jpg",
      "source_number": 508,
      "title": "占卜者 · 巴黎本",
      "original_title": "The Fortune Teller / La diseuse de bonne aventure",
      "date": "约1595—1598年",
      "year": 1597,
      "period": "early",
      "museum": "louvre",
      "accession": "INV 55",
      "tags": [
        "deception",
        "early"
      ],
      "observation": "与罗马本相比，两人的距离、脸的转向和衣服的明暗都变了。先看他们怎样握住对方的手，再找那枚几乎不显眼的戒指。",
      "story": "卢浮宫记录了这幅画从罗马维特里奇收藏、到多利亚—潘菲利家族、再到法国王室的路径。1665年，卡米洛·潘菲利亲王将它赠给路易十四。相似的罗马街头场景，就这样分别留在意大利和法国的收藏里。",
      "source_url": "https://collections.louvre.fr/ark:/53355/cl010062329",
      "source_note": "",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "label_number": 509
    },
    {
      "id": "musicians",
      "photo": "caravaggio-502.jpg",
      "source_number": 502,
      "title": "音乐家们",
      "original_title": "The Musicians",
      "date": "1597年",
      "year": 1597,
      "period": "early",
      "museum": "met",
      "accession": "52.81",
      "tags": [
        "early"
      ],
      "observation": "乐器和乐谱都已经准备好，人物却还各忙各的。左边摘葡萄的有翼少年，让这次排练又带上了寓意画的意味。",
      "story": "大都会把它放在德尔·蒙特赞助的背景下理解：枢机本人也支持音乐活动。馆方指出，右起第二个少年包含画家的自画像。1952年，作品通过罗杰斯基金进入大都会收藏。",
      "source_url": "https://www.metmuseum.org/art/collection/search/435844",
      "source_note": "",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "label_number": 503
    },
    {
      "id": "bacchus",
      "photo": "caravaggio-514.jpg",
      "source_number": 514,
      "title": "酒神",
      "original_title": "Bacchus / Bacco",
      "date": "约1598年",
      "year": 1598,
      "period": "early",
      "museum": "uffizi",
      "accession": "1890 n. 5312",
      "tags": [
        "myth",
        "early"
      ],
      "observation": "举起的酒杯几乎递到了画外。白布、酒液、皮肤和熟透的水果各有质感，人物身后的黑暗在这里还没有吞掉整个空间。",
      "story": "这幅画属于卡拉瓦乔受德尔·蒙特支持的早年罗马作品。乌菲兹在解说中特别强调静物：果篮和酒杯与人物同样值得看。画作曾长期留在馆内库房，直到20世纪初才重新受到重视。",
      "source_url": "https://www.uffizi.it/en/artworks/caravaggio-bacchus",
      "source_note": "现场展签标约1595—1597年，线上目录标约1598年；两者对重新发现的具体年份也不一致（1916／1913），这里保留差异，不把某一年写成定论。",
      "artist": "卡拉瓦乔",
      "material": "布面油画",
      "label_number": 515,
      "related_notes": [
        {
          "work": "narcissus",
          "reason": "以年轻人的身体承载神话，但这里仍须保留作者归属的问号。"
        }
      ]
    },
    {
      "id": "medusa",
      "photo": "caravaggio-518.jpg",
      "source_number": 518,
      "title": "美杜莎",
