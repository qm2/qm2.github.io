  "groups": [
    {
      "id": "land",
      "title": "陆路与绿洲",
      "text": "从印度西北和犍陀罗到中亚，再到中国，僧侣与商旅利用的是彼此交织的河谷、山口和绿洲通道。经书需要翻译，图像也在新的寺院和石窟中获得不同面貌。敦煌既是交通节点，也是保存经卷与造像的场所；长安、洛阳则连接城市生活、翻译活动与佛教营建。今天并看犍陀罗雕刻与中国造像，可以从衣纹和叙事方式辨认各自的选择。",
      "sources": [
        "silk",
        "mogao"
      ],
      "places": [
        {
          "title": "蓝毗尼、菩提伽耶、鹿野苑",
          "text": "三处圣地分别联系佛陀的诞生、成道与初次说法。它们分处今尼泊尔与印度，朝圣将生命故事与具体地点连接起来。",
          "sources": [
            "lumbini",
            "bodhgaya",
            "sarnath"
          ],
          "supplementary": false
        },
        {
          "title": "那烂陀（Nalanda）",
          "text": "今印度比哈尔邦的寺院教育遗址。僧侣在此生活与研习，远道求法者参与知识交流；它是学术共同体，不只是交通停靠点。",
          "sources": [
            "nalanda"
          ],
          "supplementary": false
        },
        {
          "title": "犍陀罗与马图拉",
          "text": "犍陀罗是历史区域，马图拉是今印度的一座城市。两地形成不同的早期造像传统，面容、衣褶与身体处理提供了比较的入口。",
          "sources": [
            "gandhara"
          ],
          "supplementary": false
        },
        {
          "title": "巴米扬（Bamiyan）",
          "text": "今阿富汗的一处山谷及佛教遗址群。石窟、寺院遗迹与不同文化传统的交会相联系，显示佛教艺术并不限于便携的小型造像。",
          "sources": [
            "bamiyan"
          ],
          "supplementary": false
        },
        {
          "title": "敦煌与莫高窟",
          "text": "敦煌是绿洲城市，莫高窟是其附近的石窟群。交通与宗教活动在此交汇，壁画、塑像和经卷使跨地域交流留下可读的痕迹。",
          "sources": [
            "mogao"
          ],
          "supplementary": false
        },
        {
          "title": "长安与洛阳",
          "text": "两座历史都城也是道路网络的重要节点。城市、寺院与石窟共同参与佛教活动；地图上的城名不能代替一件造像的具体产地。",
          "sources": [
            "silk"
          ],
          "supplementary": false
        }
      ],
      "works": [
        {
          "id": "x05",
          "relation": "本收藏中来自犍陀罗的作品"
        },
        {
          "id": "x16",
          "relation": "本收藏中来自犍陀罗的叙事浮雕"
        },
        {
          "id": "x24",
          "relation": "可联系造像发愿与汉字铭文观看"
        }
      ]
    },
    {
      "id": "mountains",
      "title": "喜马拉雅山地之间",
      "text": "山地并未隔断往来。印度、克什米尔、尼泊尔与西藏之间，求法、译经与工艺交流在不同时期展开。藏传佛教的前弘主要联系七至九世纪，后弘则自十世纪后期继续发展；这并非一条路线的两次重演。克什米尔与尼泊尔工匠的传统参与了西藏造像的形成。并看斯瓦特、尼泊尔与西藏作品，衣饰、镶嵌和莲座的差异与相近之处都值得细读。",
      "sources": [
        "rubin",
        "himalaya"
      ],
      "places": [
        {
          "title": "斯瓦特与大克什米尔",
          "text": "斯瓦特是河谷，大克什米尔是艺术史中较宽的区域称谓。两者不能当成同一地点，却能帮助理解印度西北与山地间的造像联系。",
          "sources": [
            "himalaya"
          ],
          "supplementary": true
        },
        {
          "title": "加德满都谷地",
          "text": "今尼泊尔的城市与宗教建筑密集区域，佛教和印度教传统并存。纽瓦尔工艺在本地发展，也通过跨地域委托影响西藏艺术。",
          "sources": [
            "kathmandu",
            "himalaya"
          ],
          "supplementary": true
        },
        {
          "title": "拉萨与大昭寺",
          "text": "拉萨是城市，大昭寺是其中的重要宗教场所。将城市、寺院与更广的西藏文化区域分开，有助于理解朝圣、礼拜和造像的不同尺度。",
          "sources": [
            "lhasa"
          ],
          "supplementary": false
        }
      ],
      "works": [
        {
          "id": "x15",
          "relation": "本收藏中来自斯瓦特的作品"
        },
        {
          "id": "x14",
          "relation": "本收藏中归于大克什米尔的作品"
        },
        {
          "id": "x22",
          "relation": "本收藏中来自尼泊尔的作品"
        },
        {
          "id": "x01",
          "relation": "本收藏中来自西藏的作品"
        }
      ]
    },
    {
      "id": "east",
      "title": "跨海进入东亚",
      "text": "中国、朝鲜半岛与日本之间，经典、僧侣和图像随使节、求法与海上往来流动。半岛僧侣赴中国乃至印度学习，百济也参与了日本早期佛教的传入；各地接受佛教的时间并不相同。造像形式在不同的供养环境中被选择、调整和重新制作。这里的小型金铜像，可以从身体比例与背光并看，再从两地的诞生佛接近共同的浴佛实践。",
      "sources": [
        "korea"
      ],
      "places": [
        {
          "title": "朝鲜半岛",
          "text": "这里先后存在多个政权，各自与邻近地区往来。三国时期和统一新罗的造像，有不同的取舍与转化，不能只看成外来样式的复制。",
          "sources": [
            "korea"
          ],
          "supplementary": false
        },
        {
          "title": "奈良（Nara）",
          "text": "日本八世纪的都城，寺院与其他历史建筑共同保存城市的宗教文化。它提供理解日本佛教艺术的背景，并非本辑日本作品已知的原址。",
          "sources": [
            "nara"
          ],
          "supplementary": false
        }
      ],
      "works": [
        {
          "id": "x08",
          "relation": "本收藏中来自朝鲜半岛的作品"
        },
        {
          "id": "x10",
          "relation": "可联系诞生佛与浴佛题材观看"
        },
        {
          "id": "x11",
          "relation": "可与朝鲜半岛诞生佛比较的日本作品"
        }
      ]
    },
    {
      "id": "sea",
      "title": "季风与海路",
      "text": "季风帮助船只往返印度、斯里兰卡、东南亚岛屿与中国南方港口，僧侣也借商船旅行。七世纪，义净往返印度途中在室利佛逝停留，学习梵文与经书，海岛因而也是知识交流的中心。海上往来跨越不同佛教传统，方向并不单一。斯里兰卡、泰国与爪哇的造像，可以放在这一广阔背景中比较；它们具体经过哪些港口，仍是另一层收藏史问题。",
      "sources": [
        "acri"
      ],
      "places": [
        {
          "title": "阿努拉德普勒（Anuradhapura）",
          "text": "斯里兰卡的历史城市与佛教中心。寺院、佛塔及菩提树崇敬相互联系，让人看到僧团生活、朝圣与王室支持形成的宗教空间。",
          "sources": [
            "anuradhapura"
          ],
          "supplementary": false
        },
        {
          "title": "室利佛逝与巨港",
          "text": "室利佛逝是历史政权与海上交流网络中的重要名称；巨港是今苏门答腊的一座城市。理解义净的停留，应保留政权与城市的尺度差别。",
          "sources": [
            "acri"
          ],
          "supplementary": false
        },
        {
          "title": "爪哇与婆罗浮屠",
          "text": "爪哇是岛屿，婆罗浮屠是其中一处八至九世纪的佛教建筑群。层层平台、浮雕与佛塔组织礼拜空间，显出当地佛教文化的具体面貌。",
          "sources": [
            "borobudur"
          ],
          "supplementary": false
        }
      ],
      "works": [
